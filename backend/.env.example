# Copier en .env (non versionné). Aucune valeur secrète ici.
# Dossier contenant model.keras, class_names.json et config.json
AGRISCAN_MODEL_DIR=../ml/artifacts/mobilenetv2
AGRISCAN_MAX_UPLOAD_BYTES=5242880
AGRISCAN_MAX_IMAGE_PIXELS=25000000
AGRISCAN_MIN_IMAGE_SIDE=32
# Seuil d'incertitude sur le score softmax max ; vide = désactivé (aucun seuil validé à ce jour)
# AGRISCAN_CONFIDENCE_THRESHOLD=0.8
# Origines CORS autorisées, au format JSON ; vide = CORS désactivé
# AGRISCAN_CORS_ORIGINS=["http://localhost:4200"]

# --- Comptes et historique (PostgreSQL) ---
# Format : postgresql+psycopg://utilisateur:motdepasse@hote:port/base (valeurs réelles uniquement dans .env)
# AGRISCAN_DATABASE_URL=
# Secret de signature des jetons, 32 caractères aléatoires minimum
# (ex. python -c "import secrets; print(secrets.token_urlsafe(48))")
# AGRISCAN_JWT_SECRET=
AGRISCAN_ACCESS_TOKEN_MINUTES=30
AGRISCAN_LOGIN_MAX_FAILURES=5
AGRISCAN_LOGIN_WINDOW_SECONDS=900
# Tests uniquement : serveur PostgreSQL existant (sinon pgserver embarqué est utilisé)
# AGRISCAN_TEST_DATABASE_URL=
